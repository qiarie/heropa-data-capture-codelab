#!/usr/bin/env bash
#
# Rebuilds the web app whenever a source or Gradle file is saved.
#
# Gradle's own continuous mode is not used because it does not pick up edits to
# build.gradle.kts, and step 3 of the codelab is exactly such an edit. Each
# build here is an ordinary Gradle run that reuses the warm daemon.

set -uo pipefail

cd "$CODELAB_DIR"

TASK=":webApp:wasmJsBrowserDevelopmentExecutableDistribution"
DIRTY="$(mktemp -u /tmp/codelab-dirty.XXXXXX)"
EVENTS="close_write,create,delete,move"
OUTPUT="$(mktemp /tmp/codelab-build.XXXXXX)"

# Two watches feed one flag file. Changes that land while a build is running
# set the flag again, so they are built next and never lost.
#
# Gradle writes into build folders while it runs. inotifywait still reports
# folders created there despite the exclude, so the reader drops them as well.
# Otherwise every build would start a second one.
inotifywait -m -q -r -e "$EVENTS" --exclude '(/build/|/\.gradle/|/\.kotlin/|\.swp$|\.swx$|~$)' \
    shared webApp ../gradle 2>/dev/null | while read -r dir _; do
        case "$dir" in
            */build/*|*/.gradle/*|*/.kotlin/*) continue ;;
        esac
        touch "$DIRTY"
    done &
inotifywait -m -q -e "$EVENTS" --include '\.(kts|properties)$' . 2>/dev/null \
    | while read -r _; do touch "$DIRTY"; done &
trap 'kill $(jobs -p) 2>/dev/null' EXIT

# Records what the watcher is doing in a small file that nginx serves. The
# file is replaced in one move so a reader never sees half of it.
STATUS_DIR="$HOME/.codelab"
mkdir -p "$STATUS_DIR"
BUILD=0
status() {
    printf '{"state":"%s","build":"%s-%s","epoch":%s}\n' "$1" "$$" "$BUILD" "$(date '+%s')" \
        > "$STATUS_DIR/status.json.tmp"
    mv -f "$STATUS_DIR/status.json.tmp" "$STATUS_DIR/status.json"
}

rule() { printf '%s\n' "------------------------------------------------------------"; }

touch "$DIRTY"
while true; do
    if [[ ! -e "$DIRTY" ]]; then
        sleep 1
        continue
    fi
    # A short pause lets an editor finish writing before the build starts.
    sleep 1
    rm -f "$DIRTY"

    BUILD=$((BUILD + 1))
    status building
    rule
    printf '%s  Building the app. This can take a minute.\n' "$(date '+%H:%M:%S')"
    rule
    ./gradlew --console=plain "$TASK" 2>&1 | tee "$OUTPUT" \
        | grep --line-buffered -vE '^> Task .* (UP-TO-DATE|NO-SOURCE|SKIPPED|FROM-CACHE)$|^$|^\* Try:|^> Run with |^> Get more help '
    status="${PIPESTATUS[0]}"
    rule
    if [[ "$status" -eq 0 ]]; then
        status ok
        printf '%s  \033[1;32mBUILD OK\033[0m  The App tab reloads by itself.\n' "$(date '+%H:%M:%S')"
    else
        printf '%s  \033[1;31mBUILD FAILED\033[0m  The lines starting with e above name the file, the line and the problem.\n' "$(date '+%H:%M:%S')"
        status failed
        codelab-hints "$OUTPUT" || true
    fi
    rule
done
