#!/usr/bin/env bash
#
# Starts the two things a learner needs. The first is the build watcher, which
# rebuilds the web app after every save. The second is code-server, the editor
# in the browser.

set -euo pipefail

# IDE_AUTH is password or none. With none the editor opens for anyone who
# reaches its address, terminal included, so password is the default.
AUTH="${IDE_AUTH:-password}"
case "$AUTH" in
    password)
        [[ -n "${PASSWORD:-}" ]] || { echo "PASSWORD is not set. Start the lab with lab-init.sh." >&2; exit 1; }
        ;;
    none)
        echo "IDE_AUTH is none, so the editor asks for no password." >&2
        ;;
    *)
        echo "IDE_AUTH must be password or none, not $AUTH." >&2
        exit 1
        ;;
esac

# A volume filled by an older image may lack the guide extension or hold an
# older version of it. Installing again replaces it and takes a second.
code-server --install-extension /opt/codelab/codelab-guide.vsix --force >/dev/null 2>&1 || true

# The same goes for the editor settings, which live in the volume. Every
# setting the lab defines is written again, and a setting the learner added
# is kept. A file that cannot be read is left alone.
/usr/lib/code-server/lib/node -e '
const fs = require("fs");
const [lab, mine] = process.argv.slice(1);
const read = (file) => JSON.parse(fs.readFileSync(file, "utf8"));
let current = {};
if (fs.existsSync(mine)) current = read(mine);
fs.mkdirSync(require("path").dirname(mine), { recursive: true });
fs.writeFileSync(mine, JSON.stringify({ ...current, ...read(lab) }, null, 2) + "\n");
' /opt/codelab/settings.json "$HOME/.local/share/code-server/User/settings.json" >/dev/null 2>&1 || true

# The checkout lives in the volume too. A volume made before the lab turned
# on incremental Wasm builds lacks that line, and every build then takes
# several times longer. The line is added when it is missing.
PROPS="$CODELAB_DIR/gradle.properties"
if [[ -f "$PROPS" ]] && ! grep -q '^kotlin\.incremental\.wasm=' "$PROPS"; then
    printf '\n# Added by the lab. Rebuilds only what an edit changed.\nkotlin.incremental.wasm=true\n' >> "$PROPS"
fi

LOG="$HOME/build.log"
: > "$LOG"

# The watcher is restarted if it ever stops, so a learner never has to.
(
    while true; do
        codelab-watch >> "$LOG" 2>&1 || true
        echo "The build watcher stopped and is starting again." >> "$LOG"
        sleep 2
    done
) &

exec code-server \
    --bind-addr 0.0.0.0:8080 \
    --auth "$AUTH" \
    --disable-telemetry \
    --disable-update-check \
    --disable-workspace-trust \
    --app-name "Data Capture codelab" \
    "$CODELAB_DIR"
